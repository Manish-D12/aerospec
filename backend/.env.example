# ---- Server --------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (REST + Socket.io). Use * to allow any.
CORS_ORIGIN=http://localhost:5173

# ---- PostgreSQL ----------------------------------------------------------
# Local:  postgres://postgres:postgres@localhost:5432/aerospec
# Neon:   postgres://user:pass@ep-xxx.region.aws.neon.tech/aerospec?sslmode=require
# SSL is turned off automatically for localhost / 127.0.0.1 and on for anything else.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aerospec
# Force SSL on/off regardless of host (optional): true | false
# DB_SSL=

# ---- Telemetry source ----------------------------------------------------
# Sensor the built-in simulator reports as.
SIM_SENSOR_ID=1
# Simulator tick in ms (1000 = 1 Hz).
SIM_INTERVAL_MS=1000

# ---- Optional MQTT bridge ------------------------------------------------
# Leave MQTT_URL empty to use the built-in simulator (no broker needed).
# MQTT_URL=mqtt://localhost:1883
MQTT_URL=
MQTT_TOPIC=aerospec/telemetry
# MQTT_USERNAME=
# MQTT_PASSWORD=

# ---- Auth ----------------------------------------------------------------
# Secret used to sign JWTs. REQUIRED in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, a random secret is generated at boot (all tokens die on restart) and a warning is logged.
JWT_SECRET=
# Resend API key for verification emails. If empty, the verification link is printed to this console instead.
RESEND_API_KEY=
# Sender address; must be a domain verified in Resend (onboarding@resend.dev works for testing).
EMAIL_FROM=AeroSpec <onboarding@resend.dev>
# Public URL of the frontend (verification redirects to APP_URL/login?verified=1).
APP_URL=http://localhost:5173
# Public URL of this API, used to build the link inside the email. Defaults to http://localhost:$PORT.
# API_PUBLIC_URL=https://aerospec-api.onrender.com
